# Environment Configuration
ENVIRONMENT=development
DEBUG=True

# Google APIs
GEMINI_API_KEY=your-gemini-api-key-here
GOOGLE_CIVIC_API_KEY=your-civic-api-key-here

# Security
# Comma-separated list of allowed origins (Update with your actual Cloud Run frontend URL)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:5500,https://YOUR_FRONTEND_CLOUD_RUN_URL.a.run.app
